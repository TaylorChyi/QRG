#!/usr/bin/env python3
"""Adapt the tested Sites build for bundled, offline native WebViews."""
from pathlib import Path
import argparse
import shutil
import subprocess

ROOT = Path(__file__).resolve().parent.parent
parser = argparse.ArgumentParser(description=__doc__)
parser.add_argument('--skip-build', action='store_true', help='Use the existing tested dist build')
args = parser.parse_args()
if not args.skip_build:
    subprocess.run(['npm', 'run', 'build'], cwd=ROOT, check=True)
source = ROOT / 'dist'
if not (source / 'static/zxing_reader.wasm').is_file():
    parser.error('Missing Sites build; run npm run build first')
target = ROOT / 'build/native-web'
target.mkdir(parents=True, exist_ok=True)
shutil.copytree(source, target, dirs_exist_ok=True)
shutil.copyfile(ROOT / 'native/shared/native.js', target / 'native.js')
html = (target / 'index.html').read_text(encoding='utf-8')
entry = '  <script src="/static/site-runtime.js" defer></script>'
if html.count(entry) != 1:
    raise RuntimeError('Sites script entry changed; review the native build adapter')
html = html.replace(entry, '  <script src="/native.js" defer></script>\n' + entry)
(target / 'index.html').write_text(html, encoding='utf-8')

app_path = target / 'static/app.js'
app = app_path.read_text(encoding='utf-8')
replacements = {
    '  function download(blob, filename) {':
        '  async function download(blob, filename) {\n'
        '    if (window.QRGNativeBridge) return window.QRGNativeBridge.save(blob, filename);',
    "      download(result.blob, 'qrg.svg');": "      await download(result.blob, 'qrg.svg');",
    "  pngButton.addEventListener('click', () => {\n"
    '    if (!pngButton.disabled && readyBlob && readyRevision === revision) {\n'
    "      download(readyBlob, 'qrg.png');\n"
    "      announce(t('PNG 已导出'));\n"
    '    }\n'
    '  });':
        "  pngButton.addEventListener('click', async () => {\n"
        '    if (pngButton.disabled || !readyBlob || readyRevision !== revision) return;\n'
        '    busyExport = true;\n'
        '    refreshButtons();\n'
        '    try {\n'
        "      await download(readyBlob, 'qrg.png');\n"
        "      announce(t('PNG 已导出'));\n"
        '    } catch (error) {\n'
        "      if (error.name !== 'AbortError') announce(error.message, 'error');\n"
        '    } finally {\n'
        '      busyExport = false;\n'
        '      refreshButtons();\n'
        '    }\n'
        '  });',
}
for before, after in replacements.items():
    if app.count(before) != 1:
        raise RuntimeError('Web export handler changed; review the native build adapter')
    app = app.replace(before, after)
app_path.write_text(app, encoding='utf-8')
print(f'Built native browser assets in {target}')
