#!/bin/bash
set -euo pipefail
if [[ $# -gt 1 || ( $# -eq 1 && "$1" != "--build-only" ) ]]; then
  echo "用法：$0 [--build-only]" >&2
  exit 2
fi
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
APP="$ROOT/build/QRG.app"
BIN="$APP/Contents/MacOS/QRG"
mkdir -p "$APP/Contents/MacOS" "$APP/Contents/Resources"
cp "$ROOT/assets/icon.icns" "$APP/Contents/Resources/QRG.icns"
if [ ! -x "$BIN" ] || [ "$ROOT/Sources/QRGApp.swift" -nt "$BIN" ]; then
  /usr/bin/swiftc -parse-as-library -O "$ROOT/Sources/QRGApp.swift" -o "$BIN"
fi
cat > "$APP/Contents/Info.plist" <<'EOF'
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>CFBundleExecutable</key><string>QRG</string>
<key>CFBundleIdentifier</key><string>local.qrg.app</string>
<key>CFBundleName</key><string>QRG</string>
<key>CFBundleIconFile</key><string>QRG.icns</string>
<key>CFBundlePackageType</key><string>APPL</string>
<key>NSHighResolutionCapable</key><true/>
</dict></plist>
EOF
if [[ "${1:-}" != "--build-only" ]]; then
  /usr/bin/open -n "$APP" --args "$ROOT"
fi
